# Copy this file to .env and fill in the values. Never commit .env.

# --- Valio agent gateway (port 8001) ---
# Valio Aimo mock API, from the Junction resource portal.
VALIO_BASE_URL=https://junction26.valioaimo.fi
VALIO_API_KEY=
# Valio's API returns an order cut-off time per product. When true, a product
# whose cut-off has already passed is treated as not orderable. Set to false
# if the Valio mentors say the cut-off should be ignored in the mock.
ENFORCE_ORDER_CUTOFF=true

# --- Stockpot buying agent (port 8000) ---
# Only needed if port 8000 is taken by something else on this laptop. Start
# Stockpot with the same number: uvicorn app.main:app --host 0.0.0.0 --port 8010
STOCKPOT_PORT=
# Where Stockpot finds the gateway.
GATEWAY_URL=http://127.0.0.1:8001
# Gemini (all LLM calls go through app/llm.py).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen
# How long Gemini may think before answering. "low" takes about 2 seconds per
# call; leaving this blank uses the model's own default, which took about 9.
GEMINI_THINKING_LEVEL=low
# The shelf camera's video (an MJPEG stream). Stockpot relays it to the dashboard
# and asks Gemini where the watched products stand in the picture, so they can be
# clicked. Leave the line out to use the address below; set it to blank for no camera.
CAMERA_FEED_URL=http://10.0.41.90:5000/
# Seconds between two looks at the picture. Each look is one Gemini call, and
# they are made only while a dashboard is open. Blank means 3.
VISION_INTERVAL_SECONDS=
# Exa (web checks in app/web/exa_checks.py).
EXA_API_KEY=
# Address phones should use to reach Stockpot, for the approval QR code.
# Leave blank to auto-detect this laptop's address on the local network.
PUBLIC_BASE_URL=
